{
  "extends": "node-dev",
  "meta": {
    "name": "claude-local",
    "description": "Claude Code: rw on cwd, ~/.claude and ~/.claude.json; secrets denied"
  },
  "filesystem": {
    "allow": [
      "$HOME/.claude",
      "$HOME/.npm"
    ],
    "allow_file": [
      "$HOME/.claude.json"
    ],
    "read_file": [
      "$HOME/.gitconfig"
    ],
    "read": [
      "$HOME/.config/iterm2"
    ]
  },
  "workdir": {
    "access": "readwrite"
  },
  "env_credentials": {
    "claude_code_oauth_token": "CLAUDE_CODE_OAUTH_TOKEN"
  }
}
